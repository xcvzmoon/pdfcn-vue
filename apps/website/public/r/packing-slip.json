{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "packing-slip",
  "type": "registry:block",
  "title": "Packing Slip",
  "description": "The Packing Slip document block with sample data.",
  "author": "pdfcn-vue",
  "dependencies": ["@formepdf/vue@^0.25.0", "vue@^3.4.0"],
  "registryDependencies": [
    "@pdfcn-vue/block-shared",
    "@pdfcn-vue/key-value",
    "@pdfcn-vue/page-footer",
    "@pdfcn-vue/page-header",
    "@pdfcn-vue/pdf-image",
    "@pdfcn-vue/pdfcn-core",
    "@pdfcn-vue/section",
    "@pdfcn-vue/table",
    "@pdfcn-vue/text",
    "@pdfcn-vue/theme-provider"
  ],
  "files": [
    {
      "path": "registry/components/pdf/blocks/packing-slip/PackingSlip.vue",
      "content": "<script setup lang=\"ts\">\n  import type { Style } from '@formepdf/vue';\n  import type { PdfcnTheme } from '@/lib/pdfcn/pdf-themes';\n  import type { KeyValueEntry } from '@/components/pdf/key-value.types';\n  import type { PackingSlipProps, PackingSlipSender } from '@/components/pdf/blocks/packing-slip/packing-slip.types';\n  import { Document, PAGE_NUMBER, Page, TOTAL_PAGES, View } from '@formepdf/vue';\n  import { computed } from 'vue';\n  import KeyValue from '@/components/pdf/KeyValue.vue';\n  import PageFooter from '@/components/pdf/PageFooter.vue';\n  import PageHeader from '@/components/pdf/PageHeader.vue';\n  import PdfcnThemeProvider from '@/components/pdf/PdfcnThemeProvider.vue';\n  import PdfImage from '@/components/pdf/PdfImage.vue';\n  import Section from '@/components/pdf/Section.vue';\n  import Table from '@/components/pdf/Table.vue';\n  import TableBody from '@/components/pdf/TableBody.vue';\n  import TableCell from '@/components/pdf/TableCell.vue';\n  import TableHeader from '@/components/pdf/TableHeader.vue';\n  import TableRow from '@/components/pdf/TableRow.vue';\n  import Text from '@/components/pdf/Text.vue';\n  import { usePdfcnTheme } from '@/lib/pdfcn/theme';\n  import { formatCurrency } from '@/components/pdf/blocks/shared/format';\n  import { samplePackingSlipData } from '@/components/pdf/blocks/packing-slip/packing-slip.sample';\n\n  const props = defineProps<{\n    data?: PackingSlipProps | undefined;\n    theme?: PdfcnTheme | undefined;\n  }>();\n\n  const packingSlip = computed(() => props.data ?? samplePackingSlipData);\n  const fallbackTheme = usePdfcnTheme();\n  const activeTheme = computed(() => props.theme ?? fallbackTheme.value);\n\n  const pageMargin = { bottom: 25, left: 56, right: 56, top: 56 };\n\n  function formatAddress(party: PackingSlipSender & { country?: string | undefined }): string {\n    return `${party.address}, ${party.city}, ${party.state} ${party.zip}${\n      party.country ? `, ${party.country}` : ''\n    }`;\n  }\n\n  const styles = computed(() => {\n    const current = activeTheme.value;\n\n    return {\n      columnHeading: {\n        fontSize: 9,\n        fontWeight: 700,\n        marginBottom: 2,\n      } satisfies Style,\n      page: {\n        backgroundColor: current.colors.background,\n      } satisfies Style,\n    };\n  });\n\n  const totals = computed(() => {\n    let totalPacked = 0;\n    let totalOrdered = 0;\n    for (const item of packingSlip.value.items) {\n      totalPacked += item.qtyPacked;\n      totalOrdered += item.qtyOrdered;\n    }\n    return { totalOrdered, totalPacked };\n  });\n\n  const summaryItems = computed(() => {\n    const data = packingSlip.value;\n    const items: KeyValueEntry[] = [\n      {\n        key: 'Items Packed',\n        value: `${totals.value.totalPacked} of ${totals.value.totalOrdered}`,\n      },\n    ];\n    if (data.totalPackages !== undefined) {\n      items.push({ key: 'Packages', value: `${data.totalPackages}` });\n    }\n    if (data.totalWeight) {\n      items.push({ key: 'Total Weight', value: data.totalWeight });\n    }\n    return items;\n  });\n\n  const documentTitle = computed(() => `Packing Slip ${packingSlip.value.orderNumber}`);\n  const footerRight = computed(() => `Page ${PAGE_NUMBER} of ${TOTAL_PAGES}`);\n  const headerRightSub = computed(() => `Order Date: ${packingSlip.value.orderDate}`);\n  const showFooterNotes = computed(\n    () => Boolean(packingSlip.value.thankYouMessage) || Boolean(packingSlip.value.returnsPolicy),\n  );\n</script>\n\n<template>\n  <PdfcnThemeProvider :theme=\"activeTheme\">\n    <Document :title=\"documentTitle\">\n      <Page\n        size=\"A4\"\n        :margin=\"pageMargin\"\n      >\n        <PageFooter\n          :left-text=\"packingSlip.customerService ?? packingSlip.companyName\"\n          :right-text=\"footerRight\"\n          sticky\n          :page-padding=\"25\"\n        />\n        <View :style=\"styles.page\">\n          <PageHeader\n            variant=\"logo-left\"\n            title=\"PACKING SLIP\"\n            :subtitle=\"packingSlip.companyName\"\n            :right-text=\"packingSlip.orderNumber\"\n            :right-sub-text=\"headerRightSub\"\n            :margin-bottom=\"0\"\n          >\n            <template\n              v-if=\"packingSlip.companyLogo\"\n              #logo\n            >\n              <PdfImage\n                :src=\"packingSlip.companyLogo\"\n                :style=\"{ margin: 0 }\"\n              />\n            </template>\n          </PageHeader>\n          <Section\n            no-wrap\n            :style=\"{ flexDirection: 'row' }\"\n          >\n            <View :style=\"{ flex: 1, paddingRight: 15 }\">\n              <Text\n                no-margin\n                :style=\"styles.columnHeading\"\n                color=\"mutedForeground\"\n                transform=\"uppercase\"\n              >\n                Ship To\n              </Text>\n              <Text\n                no-margin\n                variant=\"xs\"\n                >{{ packingSlip.shipTo.name }}</Text\n              >\n              <Text\n                no-margin\n                variant=\"xs\"\n                >{{ formatAddress(packingSlip.shipTo) }}</Text\n              >\n              <Text\n                v-if=\"packingSlip.shipTo.phone\"\n                no-margin\n                variant=\"xs\"\n              >\n                {{ packingSlip.shipTo.phone }}\n              </Text>\n            </View>\n            <View :style=\"{ flex: 1, paddingRight: 15 }\">\n              <Text\n                no-margin\n                :style=\"styles.columnHeading\"\n                color=\"mutedForeground\"\n                transform=\"uppercase\"\n              >\n                From\n              </Text>\n              <Text\n                no-margin\n                variant=\"xs\"\n                >{{ packingSlip.shipFrom.name }}</Text\n              >\n              <Text\n                no-margin\n                variant=\"xs\"\n                >{{ formatAddress(packingSlip.shipFrom) }}</Text\n              >\n            </View>\n            <View :style=\"{ flex: 1, paddingRight: 15 }\">\n              <Text\n                no-margin\n                :style=\"styles.columnHeading\"\n                color=\"mutedForeground\"\n                transform=\"uppercase\"\n              >\n                Order\n              </Text>\n              <Text\n                no-margin\n                variant=\"xs\"\n                >{{ packingSlip.orderNumber }}</Text\n              >\n              <Text\n                v-if=\"packingSlip.poNumber\"\n                no-margin\n                variant=\"xs\"\n              >\n                {{ `PO: ${packingSlip.poNumber}` }}\n              </Text>\n            </View>\n          </Section>\n          <Table\n            variant=\"grid\"\n            zebra-stripe\n          >\n            <TableHeader>\n              <TableRow header>\n                <TableCell text=\"Item\" />\n                <TableCell\n                  align=\"center\"\n                  text=\"SKU\"\n                />\n                <TableCell\n                  align=\"center\"\n                  text=\"Packed\"\n                />\n                <TableCell\n                  align=\"center\"\n                  text=\"Ordered\"\n                />\n                <TableCell\n                  align=\"right\"\n                  text=\"Unit Price\"\n                />\n                <TableCell\n                  align=\"right\"\n                  text=\"Total\"\n                />\n              </TableRow>\n            </TableHeader>\n            <TableBody>\n              <TableRow\n                v-for=\"item in packingSlip.items\"\n                :key=\"item.sku\"\n              >\n                <TableCell :text=\"item.name\" />\n                <TableCell\n                  align=\"center\"\n                  :text=\"item.sku\"\n                />\n                <TableCell\n                  align=\"center\"\n                  :text=\"`${item.qtyPacked}`\"\n                />\n                <TableCell\n                  align=\"center\"\n                  :text=\"`${item.qtyOrdered}`\"\n                />\n                <TableCell\n                  align=\"right\"\n                  :text=\"formatCurrency(item.unitPrice)\"\n                />\n                <TableCell\n                  align=\"right\"\n                  :text=\"formatCurrency(item.qtyPacked * item.unitPrice)\"\n                />\n              </TableRow>\n            </TableBody>\n          </Table>\n          <Section\n            no-wrap\n            :style=\"{ flexDirection: 'row', marginTop: 16 }\"\n          >\n            <View :style=\"{ flex: 1, paddingRight: 15 }\">\n              <Text\n                no-margin\n                :style=\"styles.columnHeading\"\n                color=\"mutedForeground\"\n                transform=\"uppercase\"\n              >\n                Shipping\n              </Text>\n              <Text\n                no-margin\n                variant=\"xs\"\n              >\n                {{ `${packingSlip.shipping.carrier} — ${packingSlip.shipping.method}` }}\n              </Text>\n              <Text\n                no-margin\n                variant=\"xs\"\n              >\n                {{ `Tracking: ${packingSlip.shipping.trackingNumber}` }}\n              </Text>\n              <Text\n                v-if=\"packingSlip.shipping.estimatedDelivery\"\n                no-margin\n                variant=\"xs\"\n              >\n                {{ `Est. Delivery: ${packingSlip.shipping.estimatedDelivery}` }}\n              </Text>\n            </View>\n            <View :style=\"{ marginLeft: 'auto', width: 220 }\">\n              <KeyValue\n                size=\"sm\"\n                :divider-thickness=\"1\"\n                :items=\"summaryItems\"\n                divided\n              />\n            </View>\n          </Section>\n          <Section\n            v-if=\"showFooterNotes\"\n            spacing=\"sm\"\n            variant=\"highlight\"\n            :accent-color=\"packingSlip.accentColor ?? 'primary'\"\n          >\n            <Text\n              v-if=\"packingSlip.thankYouMessage\"\n              variant=\"sm\"\n              weight=\"medium\"\n              no-margin\n            >\n              {{ packingSlip.thankYouMessage }}\n            </Text>\n            <Text\n              v-if=\"packingSlip.returnsPolicy\"\n              variant=\"xs\"\n              color=\"mutedForeground\"\n              no-margin\n            >\n              {{ packingSlip.returnsPolicy }}\n            </Text>\n          </Section>\n        </View>\n      </Page>\n    </Document>\n  </PdfcnThemeProvider>\n</template>\n",
      "type": "registry:block"
    },
    {
      "path": "registry/components/pdf/blocks/packing-slip/packing-slip.types.ts",
      "content": "export type PackingSlipRecipient = {\n  name: string;\n  address: string;\n  city: string;\n  state: string;\n  zip: string;\n  country?: string | undefined;\n  phone?: string | undefined;\n};\n\nexport type PackingSlipSender = {\n  name: string;\n  address: string;\n  city: string;\n  state: string;\n  zip: string;\n};\n\nexport type PackingSlipItem = {\n  name: string;\n  sku: string;\n  qtyPacked: number;\n  qtyOrdered: number;\n  unitPrice: number;\n};\n\nexport type PackingSlipShipping = {\n  carrier: string;\n  trackingNumber: string;\n  method: string;\n  estimatedDelivery?: string | undefined;\n};\n\nexport type PackingSlipProps = {\n  companyName: string;\n  companyLogo?: string | undefined;\n  orderNumber: string;\n  orderDate: string;\n  poNumber?: string | undefined;\n  shipTo: PackingSlipRecipient;\n  shipFrom: PackingSlipSender;\n  items: PackingSlipItem[];\n  shipping: PackingSlipShipping;\n  totalPackages?: number | undefined;\n  totalWeight?: string | undefined;\n  returnsPolicy?: string | undefined;\n  customerService?: string | undefined;\n  thankYouMessage?: string | undefined;\n  accentColor?: string | undefined;\n};\n",
      "type": "registry:lib"
    },
    {
      "path": "registry/components/pdf/blocks/packing-slip/packing-slip.sample.ts",
      "content": "import type { PackingSlipProps } from '@/components/pdf/blocks/packing-slip/packing-slip.types';\n\nexport const samplePackingSlipData: PackingSlipProps = {\n  accentColor: '#059669',\n  companyName: 'Acme Store',\n  customerService: 'support@acme-store.com',\n  items: [\n    {\n      name: 'Widget Pro',\n      qtyOrdered: 2,\n      qtyPacked: 2,\n      sku: 'WP-001',\n      unitPrice: 49.99,\n    },\n    {\n      name: 'Gadget Lite',\n      qtyOrdered: 1,\n      qtyPacked: 1,\n      sku: 'GL-010',\n      unitPrice: 29.99,\n    },\n    {\n      name: 'Cable Kit',\n      qtyOrdered: 3,\n      qtyPacked: 2,\n      sku: 'CK-204',\n      unitPrice: 9.5,\n    },\n  ],\n  orderDate: 'Sep 10, 2026',\n  orderNumber: 'ORD-2026-0891',\n  poNumber: 'PO-4471',\n  returnsPolicy: 'Returns accepted within 30 days with original packaging.',\n  shipFrom: {\n    address: '100 Industrial Blvd',\n    city: 'Seattle',\n    name: 'Acme Warehouse',\n    state: 'WA',\n    zip: '98101',\n  },\n  shipTo: {\n    address: '456 Oak Ave',\n    city: 'Portland',\n    name: 'Jane Doe',\n    phone: '(503) 555-0142',\n    state: 'OR',\n    zip: '97201',\n  },\n  shipping: {\n    carrier: 'UPS',\n    estimatedDelivery: 'Sep 15, 2026',\n    method: 'Ground',\n    trackingNumber: '1Z999AA10123456784',\n  },\n  thankYouMessage: 'Thank you for your order!',\n  totalPackages: 1,\n  totalWeight: '3.2 kg',\n};\n",
      "type": "registry:lib"
    }
  ],
  "categories": ["block"]
}
