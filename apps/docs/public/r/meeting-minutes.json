{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "meeting-minutes",
  "type": "registry:block",
  "title": "Meeting Minutes",
  "description": "The Meeting Minutes document block with sample data.",
  "author": "pdfcn-vue",
  "dependencies": ["@formepdf/vue@^0.25.0", "vue@^3.4.0"],
  "registryDependencies": [
    "https://pdfcn-vue.example.com/r/badge.json",
    "https://pdfcn-vue.example.com/r/list.json",
    "https://pdfcn-vue.example.com/r/page-footer.json",
    "https://pdfcn-vue.example.com/r/page-header.json",
    "https://pdfcn-vue.example.com/r/pdfcn-core.json",
    "https://pdfcn-vue.example.com/r/section.json",
    "https://pdfcn-vue.example.com/r/table.json",
    "https://pdfcn-vue.example.com/r/text.json",
    "https://pdfcn-vue.example.com/r/theme-provider.json"
  ],
  "files": [
    {
      "path": "registry/components/pdf/blocks/meeting-minutes/MeetingMinutes.vue",
      "content": "<script setup lang=\"ts\">\nimport type { Style } from '@formepdf/vue';\nimport type { PdfcnTheme } from '@/lib/pdfcn/pdf-themes';\nimport type {\n  MeetingMinutesActionStatus,\n  MeetingMinutesAttendee,\n  MeetingMinutesProps,\n} from '@/components/pdf/blocks/meeting-minutes/meeting-minutes.types';\nimport { Document, PAGE_NUMBER, Page, TOTAL_PAGES, View } from '@formepdf/vue';\nimport { computed } from 'vue';\nimport Badge from '@/components/pdf/Badge.vue';\nimport PageFooter from '@/components/pdf/PageFooter.vue';\nimport PageHeader from '@/components/pdf/PageHeader.vue';\nimport PdfcnThemeProvider from '@/components/pdf/PdfcnThemeProvider.vue';\nimport PdfList from '@/components/pdf/PdfList.vue';\nimport Section from '@/components/pdf/Section.vue';\nimport Table from '@/components/pdf/Table.vue';\nimport TableBody from '@/components/pdf/TableBody.vue';\nimport TableCell from '@/components/pdf/TableCell.vue';\nimport TableHeader from '@/components/pdf/TableHeader.vue';\nimport TableRow from '@/components/pdf/TableRow.vue';\nimport Text from '@/components/pdf/Text.vue';\nimport { usePdfcnTheme } from '@/lib/pdfcn/theme';\nimport { sampleMeetingMinutesData } from '@/components/pdf/blocks/meeting-minutes/meeting-minutes.sample';\n\nconst props = defineProps<{\n  data?: MeetingMinutesProps | undefined;\n  theme?: PdfcnTheme | undefined;\n}>();\n\nconst minutes = computed(() => props.data ?? sampleMeetingMinutesData);\nconst fallbackTheme = usePdfcnTheme();\nconst activeTheme = computed(() => props.theme ?? fallbackTheme.value);\n\nconst STATUS_VARIANT: Record<MeetingMinutesActionStatus, 'success' | 'info' | 'default'> = {\n  Complete: 'success',\n  'In Progress': 'info',\n  'Not Started': 'default',\n};\n\nfunction formatAttendee(attendee: MeetingMinutesAttendee): string {\n  return attendee.role ? `${attendee.name} — ${attendee.role}` : attendee.name;\n}\n\nconst styles = computed(() => {\n  const current = activeTheme.value;\n  return {\n    columnHeading: {\n      fontSize: 9,\n      fontWeight: 700,\n      marginBottom: 2,\n    } satisfies Style,\n    discussionTopic: {\n      marginBottom: current.primitives.spacing[2],\n    } satisfies Style,\n    listItem: {\n      marginBottom: current.primitives.spacing[1],\n    } satisfies Style,\n    page: {\n      backgroundColor: current.colors.background,\n    } satisfies Style,\n  };\n});\n\ntype AttendeeColumn = { heading: string; names: string[] };\n\nconst attendeeColumns = computed(() => {\n  const data = minutes.value;\n  const columns: AttendeeColumn[] = [\n    { heading: 'Attendees', names: data.attendees.map(formatAttendee) },\n  ];\n  if (data.absent?.length) {\n    columns.push({ heading: 'Absent', names: data.absent.map(formatAttendee) });\n  }\n  if (data.guests?.length) {\n    columns.push({ heading: 'Guests', names: data.guests });\n  }\n  return columns;\n});\n\nconst documentTitle = computed(() => `Minutes — ${minutes.value.meetingTitle}`);\nconst subtitle = computed(\n  () => `${minutes.value.location} · Organized by ${minutes.value.organizer}`,\n);\nconst footerLeft = computed(() => `Prepared by ${minutes.value.preparedBy}`);\nconst footerRight = computed(() => {\n  const list = minutes.value.distributionList;\n  if (!list || list.length === 0) return undefined;\n  return `Distribution: ${list.join(', ')}`;\n});\nconst pageFooterRight = computed(() => `Page ${PAGE_NUMBER} of ${TOTAL_PAGES}`);\nconst discussionNotes = computed(() =>\n  minutes.value.discussions.map((discussion) => ({\n    ...discussion,\n    noteItems: discussion.notes.map((text) => ({ text })),\n  })),\n);\nconst nextAgendaItems = computed(() =>\n  (minutes.value.nextMeeting?.agenda ?? []).map((text) => ({ text })),\n);\n</script>\n\n<template>\n  <PdfcnThemeProvider :theme=\"activeTheme\">\n    <Document :title=\"documentTitle\">\n      <Page size=\"A4\" :margin=\"{ bottom: 25, left: 56, right: 56, top: 56 }\">\n        <PageFooter :left-text=\"footerLeft\" :right-text=\"footerRight\" sticky :page-padding=\"25\" />\n        <View :style=\"styles.page\">\n          <PageHeader\n            variant=\"simple\"\n            :title=\"minutes.meetingTitle\"\n            :subtitle=\"subtitle\"\n            :right-text=\"minutes.date\"\n            :right-sub-text=\"minutes.time\"\n            :margin-bottom=\"0\"\n          />\n          <Section spacing=\"sm\" :style=\"{ flexDirection: 'row' }\">\n            <View\n              v-for=\"column in attendeeColumns\"\n              :key=\"column.heading\"\n              :style=\"{ flex: 1, paddingRight: 15 }\"\n            >\n              <Text\n                :style=\"styles.columnHeading\"\n                color=\"mutedForeground\"\n                transform=\"uppercase\"\n                no-margin\n              >\n                {{ column.heading }}\n              </Text>\n              <Text v-for=\"name in column.names\" :key=\"name\" variant=\"xs\" no-margin>\n                {{ name }}\n              </Text>\n            </View>\n          </Section>\n          <Section spacing=\"sm\">\n            <Text\n              :style=\"styles.columnHeading\"\n              color=\"mutedForeground\"\n              transform=\"uppercase\"\n              no-margin\n            >\n              Agenda\n            </Text>\n            <Text\n              v-for=\"(item, index) in minutes.agenda\"\n              :key=\"item\"\n              :style=\"styles.listItem\"\n              variant=\"sm\"\n              no-margin\n            >\n              {{ `${index + 1}. ${item}` }}\n            </Text>\n          </Section>\n          <Section spacing=\"sm\">\n            <Text\n              :style=\"styles.columnHeading\"\n              color=\"mutedForeground\"\n              transform=\"uppercase\"\n              no-margin\n            >\n              Discussion\n            </Text>\n            <View\n              v-for=\"discussion in discussionNotes\"\n              :key=\"discussion.topic\"\n              :style=\"styles.discussionTopic\"\n            >\n              <Text variant=\"sm\" weight=\"semibold\" no-margin>{{ discussion.topic }}</Text>\n              <Text v-if=\"discussion.speaker\" variant=\"xs\" color=\"mutedForeground\" no-margin>\n                {{ `— ${discussion.speaker}` }}\n              </Text>\n              <PdfList variant=\"bullet\" gap=\"xs\" :items=\"discussion.noteItems\" />\n            </View>\n          </Section>\n        </View>\n      </Page>\n      <Page size=\"A4\" :margin=\"{ bottom: 25, left: 56, right: 56, top: 56 }\">\n        <PageFooter\n          :left-text=\"footerLeft\"\n          :right-text=\"pageFooterRight\"\n          sticky\n          :page-padding=\"25\"\n        />\n        <View :style=\"styles.page\">\n          <Section spacing=\"sm\">\n            <Text\n              :style=\"styles.columnHeading\"\n              color=\"mutedForeground\"\n              transform=\"uppercase\"\n              no-margin\n            >\n              Decisions\n            </Text>\n            <View\n              v-for=\"decision in minutes.decisions\"\n              :key=\"decision.number\"\n              :style=\"styles.discussionTopic\"\n            >\n              <Text variant=\"sm\" weight=\"semibold\" no-margin>\n                {{ `${decision.number}. ${decision.decision}` }}\n              </Text>\n              <Text v-if=\"decision.rationale\" variant=\"xs\" color=\"mutedForeground\" no-margin>\n                {{ decision.rationale }}\n              </Text>\n            </View>\n          </Section>\n          <Section spacing=\"sm\">\n            <Text\n              :style=\"styles.columnHeading\"\n              color=\"mutedForeground\"\n              transform=\"uppercase\"\n              no-margin\n            >\n              Action Items\n            </Text>\n            <Table variant=\"grid\" zebra-stripe>\n              <TableHeader>\n                <TableRow header>\n                  <TableCell text=\"Task\" />\n                  <TableCell align=\"center\" text=\"Owner\" />\n                  <TableCell align=\"center\" text=\"Due Date\" />\n                  <TableCell align=\"center\" text=\"Status\" />\n                </TableRow>\n              </TableHeader>\n              <TableBody>\n                <TableRow v-for=\"item in minutes.actionItems\" :key=\"item.task\">\n                  <TableCell :text=\"item.task\" />\n                  <TableCell align=\"center\" :text=\"item.owner\" />\n                  <TableCell align=\"center\" :text=\"item.dueDate\" />\n                  <TableCell align=\"center\">\n                    <Badge :variant=\"STATUS_VARIANT[item.status]\" size=\"sm\" :label=\"item.status\" />\n                  </TableCell>\n                </TableRow>\n              </TableBody>\n            </Table>\n          </Section>\n          <Section\n            v-if=\"minutes.nextMeeting\"\n            spacing=\"sm\"\n            variant=\"highlight\"\n            :accent-color=\"minutes.accentColor ?? 'primary'\"\n          >\n            <Text\n              :style=\"styles.columnHeading\"\n              color=\"mutedForeground\"\n              transform=\"uppercase\"\n              no-margin\n            >\n              Next Meeting\n            </Text>\n            <Text variant=\"sm\" weight=\"medium\" no-margin>\n              {{ `${minutes.nextMeeting.date} · ${minutes.nextMeeting.time}` }}\n            </Text>\n            <PdfList\n              v-if=\"minutes.nextMeeting.agenda\"\n              variant=\"bullet\"\n              gap=\"xs\"\n              :items=\"nextAgendaItems\"\n            />\n          </Section>\n        </View>\n      </Page>\n    </Document>\n  </PdfcnThemeProvider>\n</template>\n",
      "type": "registry:block"
    },
    {
      "path": "registry/components/pdf/blocks/meeting-minutes/meeting-minutes.types.ts",
      "content": "export type MeetingMinutesAttendee = {\n  name: string;\n  role?: string | undefined;\n};\n\nexport type MeetingMinutesDiscussion = {\n  topic: string;\n  notes: string[];\n  speaker?: string | undefined;\n};\n\nexport type MeetingMinutesDecision = {\n  number: number;\n  decision: string;\n  rationale?: string | undefined;\n};\n\nexport type MeetingMinutesActionStatus = 'Not Started' | 'In Progress' | 'Complete';\n\nexport type MeetingMinutesActionItem = {\n  task: string;\n  owner: string;\n  dueDate: string;\n  status: MeetingMinutesActionStatus;\n};\n\nexport type MeetingMinutesNextMeeting = {\n  date: string;\n  time: string;\n  agenda?: string[] | undefined;\n};\n\nexport type MeetingMinutesProps = {\n  meetingTitle: string;\n  date: string;\n  time: string;\n  location: string;\n  organizer: string;\n  attendees: MeetingMinutesAttendee[];\n  absent?: MeetingMinutesAttendee[] | undefined;\n  guests?: string[] | undefined;\n  agenda: string[];\n  discussions: MeetingMinutesDiscussion[];\n  decisions: MeetingMinutesDecision[];\n  actionItems: MeetingMinutesActionItem[];\n  nextMeeting?: MeetingMinutesNextMeeting | undefined;\n  preparedBy: string;\n  distributionList?: string[] | undefined;\n  accentColor?: string | undefined;\n};\n",
      "type": "registry:lib"
    },
    {
      "path": "registry/components/pdf/blocks/meeting-minutes/meeting-minutes.sample.ts",
      "content": "import type { MeetingMinutesProps } from '@/components/pdf/blocks/meeting-minutes/meeting-minutes.types';\n\nexport const sampleMeetingMinutesData: MeetingMinutesProps = {\n  absent: [{ name: 'Casey Wu', role: 'QA Lead' }],\n  accentColor: '#0891b2',\n  actionItems: [\n    {\n      dueDate: 'Sep 19, 2026',\n      owner: 'Jordan Lee',\n      status: 'In Progress',\n      task: 'Create pdfme integration RFC',\n    },\n    {\n      dueDate: 'Sep 22, 2026',\n      owner: 'Sam Patel',\n      status: 'Not Started',\n      task: 'Design community page wireframes',\n    },\n    {\n      dueDate: 'Sep 26, 2026',\n      owner: 'Alex Kim',\n      status: 'Complete',\n      task: 'Share Q2 outcomes deck with stakeholders',\n    },\n  ],\n  agenda: [\n    'Review Q2 outcomes',\n    'Q3 feature priorities',\n    'Resource allocation',\n    'Timeline and milestones',\n  ],\n  attendees: [\n    { name: 'Alex Kim', role: 'Product Lead' },\n    { name: 'Jordan Lee', role: 'Engineering Lead' },\n    { name: 'Sam Patel', role: 'Design Lead' },\n  ],\n  date: 'September 12, 2026',\n  decisions: [\n    {\n      decision: 'Proceed with pdfme as second rendering base',\n      number: 1,\n      rationale: 'Better JSX support',\n    },\n    {\n      decision: 'Allocate 2 engineers to PDF module full-time',\n      number: 2,\n    },\n  ],\n  discussions: [\n    {\n      notes: ['Shipped 4 of 5 planned features', 'Customer satisfaction up 12%'],\n      speaker: 'Alex Kim',\n      topic: 'Q2 Outcomes',\n    },\n    {\n      notes: ['PDF generation module is top priority', 'Community page scheduled for late Q3'],\n      speaker: 'Jordan Lee',\n      topic: 'Q3 Feature Priorities',\n    },\n  ],\n  distributionList: ['product-team@acme.com', 'eng-leads@acme.com'],\n  guests: ['Riya Shah (Advisor)'],\n  location: 'Conference Room B / Zoom',\n  meetingTitle: 'Q3 Product Roadmap Review',\n  nextMeeting: {\n    agenda: ['Review action items', 'pdfme RFC walkthrough'],\n    date: 'September 19, 2026',\n    time: '2:00 PM',\n  },\n  organizer: 'Alex Kim',\n  preparedBy: 'Alex Kim',\n  time: '2:00 PM - 3:30 PM',\n};\n",
      "type": "registry:lib"
    }
  ],
  "categories": ["block"]
}
