{
  "name": "pdfcn-vue",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "typecheck": "vp run --filter @pdfcn-vue/docs --filter @pdfcn-vue/registry --filter @pdfcn-vue/build-registry typecheck",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "test:verbose": "vp test --reporter=verbose",
    "registry:build": "node tools/build-registry/src/cli.ts",
    "registry:e2e": "node tools/build-registry/scripts/e2e-install.ts",
    "release": "genbumppush --yes"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "genbumppush": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
